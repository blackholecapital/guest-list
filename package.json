{
  "name": "guest-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "typecheck": "tsc -b --pretty false",
    "db:migrate:local": "wrangler d1 migrations apply guest-list-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply guest-list-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name guest-list"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "~5.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260726.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "wrangler": "^4.86.0"
  }
}
