{
  "name": "guest-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "typecheck": "tsc -b --pretty false",
    "db:migrate:local": "wrangler d1 migrations apply guest-list-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply guest-list-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name guest-list"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "rollup": "^4.21.3",
    "vite": "^6.4.1",
    "wrangler": "^4.118.0"
  }
}
